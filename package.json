{
  "name": "workflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0 && pnpm lint:styles",
    "lint:styles": "stylelint src/**/*.less",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@xyflow/react": "^12.3.2",
    "antd": "~5.19.4",
    "axios": "^1.12.2",
    "less": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.25.1",
    "styled-components": "^6.1.12",
    "zustand": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "postcss-less": "^6.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.0"
  }
